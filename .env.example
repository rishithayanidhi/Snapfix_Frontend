# SnapFix Flutter App Configuration Example
# Copy this file to .env and update with your actual values

# ===== API Configuration =====
# Backend API URL
# Development: http://10.0.2.2:8000 (for Android emulator)
# Development: http://localhost:8000 (for iOS simulator)
# Production: https://your-backend-domain.com
API_BASE_URL=http://10.0.2.2:8000

# ===== Debug Configuration =====
DEBUG=true

# ===== Supabase Configuration =====
# Get these from: https://supabase.com → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_BUCKET=complaint-images
